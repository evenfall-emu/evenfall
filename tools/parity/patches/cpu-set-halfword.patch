+
+// Evenfall: what the retail CpuSet loop's LDRH loads from `address`: the
+// aligned halfword (on the 8-bit save bus, the byte at the address itself),
+// rotated right by 8 at an odd address, as the CPU's LDRH does.
+fn hleLoadHalfword(bus: *Bus, address: u32) u32 {
+    const bus_address = if (bus_module.isByteWideSaveAddress(address)) address else address & ~@as(u32, 1);
+    const value = bus.read(.{
+        .address = bus_address,
+        .width = .half,
+        .kind = .nonsequential,
+        .source = .cpu_data,
+    }).value;
+    return std.math.rotr(u32, value, (address & 1) * 8);
+}
+
+// Evenfall: the retail CpuSet loop's STRH of `value` at `address`: aligned,
+// except on the 8-bit save bus.
+fn hleStoreHalfword(bus: *Bus, address: u32, value: u32) void {
+    const bus_address = if (bus_module.isByteWideSaveAddress(address)) address else address & ~@as(u32, 1);
+    _ = bus.write(.{
+        .address = bus_address,
+        .width = .half,
+        .kind = .nonsequential,
+        .source = .cpu_data,
+    }, value);
+}
