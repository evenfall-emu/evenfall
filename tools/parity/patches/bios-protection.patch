+    /// Evenfall parity patch: BIOS read protection with an image. An opcode
+    /// fetch reads the image and latches its aligned word; a data read sees
+    /// the image only while the most recent opcode fetch was from the BIOS;
+    /// any other read returns the latch.
+    fn readProtectedBios(self: *Bus, address: u32, width: AccessWidth, source: AccessSource) u32 {
+        if (self.bios.len == bios_size and source == .cpu_code) {
+            self.bios_latch = self.readBios(address & ~@as(u32, 3), .word);
+        } else if (self.bios.len == bios_size and !self.bios_code_active) {
+            const shift: u5 = switch (width) {
+                .byte => @intCast((address & 3) * 8),
+                .half => @intCast((address & 2) * 8),
+                .word => 0,
+            };
+            const mask: u32 = switch (width) {
+                .byte => 0xFF,
+                .half => 0xFFFF,
+                .word => 0xFFFF_FFFF,
+            };
+            return (self.bios_latch >> shift) & mask;
+        }
+        return self.readBios(address, width);
+    }
