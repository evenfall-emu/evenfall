// Deployment configuration for the official play.evenfall-emu.org instance.
// Wrangler takes the Cloudflare account from CLOUDFLARE_ACCOUNT_ID (or
// `wrangler login`). Build with `bash web/cloudflare/build.sh`, then deploy
// from the repository root with
// `npx wrangler deploy --config web/cloudflare/wrangler.jsonc`.
// Self-hosted deployments must replace the instance-specific values below; see
// docs/server.md#self-hosting.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Deployed identifier: the Worker's name in the Cloudflare account. Workers
  // Builds refuses to deploy when it differs from the dashboard's Worker.
  "name": "zigba",
  "main": "../server/src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BETTER_AUTH_URL": "https://play.evenfall-emu.org",
    "DISCORD_CLIENT_ID": "1551951883109666826",
    "EMAIL_FROM": "noreply@evenfall-emu.org",
    "PATCHES_URL": "https://patches.evenfall-emu.org",
  },
  "secrets": { "required": ["BETTER_AUTH_SECRET", "DISCORD_CLIENT_SECRET"] },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@evenfall-emu.org"],
    },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "play.evenfall-emu.org", "custom_domain": true }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "binding": "ASSETS",
    "directory": "../../.dist/cloudflare",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/library",
      "/library/*",
      "/manage",
      "/manage/*",
      "/player",
      "/share/*",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Deployed identifier: the production D1 database.
      "database_name": "zigba-catalog",
      "database_id": "c3168a8a-7b59-433b-9c4b-7b1a55238e4d",
      "migrations_dir": "../server/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "SAVES",
      // Deployed identifier: the private cloud-save bucket. Its object keys
      // (<account>/<ROM SHA-1>/<playthrough>/<kind>, share/state/<id> and
      // share/rom/<id>) are durable too.
      "bucket_name": "zigba-saves",
      "jurisdiction": "eu",
    },
    {
      "binding": "PATCHES",
      "bucket_name": "evenfall-patches",
      "jurisdiction": "eu",
    },
  ],
}
