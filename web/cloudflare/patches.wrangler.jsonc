// Public patch CDN Worker; the existing patches.evenfall-emu.org R2 custom
// domain provides the proxied DNS record, and this Worker route runs first.
// Deploy from the repository root with
// `npx wrangler deploy --config web/cloudflare/patches.wrangler.jsonc`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Deployed identifier: the Worker's name in the Cloudflare account. Workers
  // Builds refuses to deploy when it differs from the dashboard's Worker.
  "name": "zigba-patches",
  "main": "../server/src/patches.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": ["patches.evenfall-emu.org/*"],
  "r2_buckets": [
    {
      "binding": "PATCHES",
      "bucket_name": "evenfall-patches",
      "jurisdiction": "eu",
    },
  ],
}
