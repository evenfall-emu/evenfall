# HTML and the service worker retain Cloudflare's default must-revalidate.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite includes content hashes in these filenames, including the SDK worker,
# audio worklet and WASM.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
