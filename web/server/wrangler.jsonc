// Local development only. `npm run dev` and `npm run db:migrate:local` use
// Wrangler's local simulation under server/.wrangler/; the D1 ID and R2 bucket
// below are placeholders that do not refer to any deployed resource. Never
// run this configuration with --remote. Deployment uses ../wrangler.jsonc.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "zigba-catalog-dev",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "vars": {
    "BETTER_AUTH_URL": "http://127.0.0.1:5173",
    "DISCORD_CLIENT_ID": "1551951883109666826",
    "EMAIL_FROM": "noreply@evenfall-emu.org",
    "PATCHES_URL": "http://127.0.0.1:8788"
  },
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["noreply@evenfall-emu.org"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zigba-catalog",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SAVES",
      "bucket_name": "zigba-saves-local",
      "jurisdiction": "eu"
    },
    {
      "binding": "PATCHES",
      "bucket_name": "evenfall-patches",
      "jurisdiction": "eu"
    }
  ]
}
