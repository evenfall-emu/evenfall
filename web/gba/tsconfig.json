{
  // Compiles the TypeScript bridge (src/bridge) to bridge/*.js + .d.ts for
  // the published package. Workspace consumers read the sources directly
  // through the "zigba-source" export condition; see docs/sdk.md.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": ".",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "types": []
  },
  "include": ["src"],
  "exclude": ["bridge"]
}
