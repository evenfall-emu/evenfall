#!/usr/bin/env bash
# Fast, idempotent repairs after an orb resumes. The toolchains and references
# installed by setup are local files and need nothing.
set -euo pipefail

# Oxlint, behind vp check and vp lint, reserves more virtual memory than the
# kernel's default overcommit heuristic allows here and panics before linting.
sudo sysctl -q -w vm.overcommit_memory=1
